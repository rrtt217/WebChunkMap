; WebChunkMap - WebAdmin 区块地图配置
; 注意：Cuberite 的 INI 解析会把 "=" 前的空格算进键名，这里一律使用 Key=Value（无空格）。

[Web]
; WebAdmin 左侧菜单里显示的标签名
TabTitle=Chunk Map
; 默认视野：以区块为单位的边长（8 => 128x128 格）
DefaultSizeChunks=8
; 默认每格像素数（1..4）
DefaultScale=2
; 默认渲染模式：topo（地表）| biome（生物群系）| chunks（区块加载状态）
DefaultMode=topo
; 是否把 PNG 以 data: URI 内联进 HTML。
; 必须为 1：WebAdmin 会把插件标签页返回的内容（无论 ContentType 是什么）一律塞进
; 模板 HTML，所以 <img src="...?format=png"> 拿到的是 HTML 而不是图片。
UseInlineImages=1

[Render]
; 图片缓存的后台刷新阈值（秒）。
; 它只决定"什么时候在后台重绘这份缓存"，不决定"这次请求能不能用缓存" ——
; 命中但过期的图会先照常发给浏览器，再在 tick 线程上重绘，页面不会因此跳转。
; 想立刻看最新的，勾页面上的「强制重绘」。
CacheTTL=600
; 图片缓存条目上限
MaxCacheEntries=24
; 单张图片最大像素数（宽*高），超出会自减视野
MaxPixels=1000000
; 允许的最大视野（区块）
MaxSizeChunks=48
; 每 16 格画一条暗色区块边界线
DrawChunkGrid=1
; 根据高度差做简易山体阴影
HillShading=1
; 在地图上标出在线玩家与出生点
DrawPlayers=1
; 在地图上标出结构位置（村庄 / 废弃矿井 / 神殿 …）。
; 数据来自 VanillaFeatureComplement 插件的 Locate API：如果那个插件没装，
; 这项就等于没开——插件会静默跳过，不报错也不写日志。
; 代价：每次重绘会按结构类型各查询一次（窗口只需盖住视野），类型多/视野大时开销上升。
DrawStructures=1
; PNG 的 ZLIB 压缩等级（0..9）
; PNG 压缩等级 0~9。0 是"不压缩"，但**它反而最慢** —— 见下面的实测。
;
; 实测（48x48 视野 = 768x768，含 CRC32 与拼装的全部编码耗时）：
;     等级 0 : 198 ms / 1729 KiB    <- 陷阱：省了压缩 CPU，但 IDAT 变成原始大小，
;                                     而 CRC32 是按**压缩后**字节数算的，反而多花 140 ms
;     等级 1 :  47 ms /  290 KiB    <- 最快
;     等级 2 :  52 ms /  265 KiB
;     等级 3 :  56 ms /  261 KiB
;     等级 4 :  55 ms /  258 KiB
;     等级 6 :  58 ms /  252 KiB    <- 默认值
;     等级 9 : 146 ms /  246 KiB    <- 陷阱：只小 2.5%，但 zlib 自己变重，慢 88 ms
;
; 经验公式：编码耗时 ≈ 2 ms + zlib(等级) + 0.1us x 压缩后字节数。
; 所以 1~6 都在最优点附近（彼此只差 10 ms 上下，接近测量噪声）。
; 默认 6 是权衡过的：比 1 慢约 10 ms，但每张图小 38 KiB ——
; 而页面是把 PNG 以 base64 内联的（再涨 33%），树莓派走 tailnet 时体积更值钱。
; 想更偏速度可以降到 1~4；别设 0，也别指望 9。
PngCompression=6
; PNG 行滤波：none 或 sub。
; 实测（48x48 视野 = 768x768 真实地图）：none 比 sub 快 26%、小 18%。
; 地图是大片同色，zlib 本来就能压住长重复串；sub 反而把重复串打散。
; 除非你的地形很不一样，否则保持 none。
PngFilter=none

[Cache]
; 是否记住“曾经加载过”的区块：每个区块只存 1280 字节的渲染快照
; （768 字节顶面颜色 + 256 字节地表高度 + 256 字节生物群系），
; 不是 16x16x256 的方块数据。区块被引擎卸载后，地图依然能画出它的地形。
RememberChunks=1
; 记忆中的区块的压暗系数（1.0 = 与实时加载完全一致，0.85 = 略微压暗以便区分）
RememberedShade=1.0
; 快照数量上限（每个约 1.25 KiB 内存；落盘文件约为该值 * 1.25 KB）
MaxChunks=6000
; 一个世界里"已加载区块"的总量阀门。0 = 不限。
; 区块才是内存大头：Cuberite 每个已加载区块约 150~200 KB，而这插件会不停地
; 通过 ChunkStay 把视野里的区块拉进内存。达到上限后：
;   * 自动补全/加载按钮会被"按剩余额度截断"，额度为 0 时整个跳过；
;   * 页面上会显示一行说明，日志里每分钟最多一条。
; 估法：可用内存 MiB ÷ 0.2。例：树莓派可用 140 MiB -> 设 600。
; 重新生成(regenerate)不受这个阀门限制 —— 那是显式操作，且一次最多 64 个。
MaxLoadedChunks=0

; 快照自动落盘间隔（秒）
SaveInterval=300

; 平移地图时自动补全视野内“从未见过”的区块（地图会一路平移一路补全）。
; 注意：这会真的去生成新地形，和玩家走过去一样有 CPU 开销。
AutoLoadOnView=1
; 自动补全单次上限（比手动按钮的 512 小，避免一次生成太多）
AutoLoadMaxChunks=256
; 手动「加载可见区块」按钮的单次上限。
; 注意每个区块约 150~200 KB **常驻内存**（Cuberite 的 chunkmap 持有），512 就是约 100 MB。
; 小内存机器务必调小（树莓派建议 32~64）。自动补全用的是 AutoLoadMaxChunks，不是这个。
MaxWarmChunks=512
; 同一区域的自动补全冷却（秒）。
; 要小于页面自动刷新的 6 秒，否则刷新时还在冷却期、补全链会中断。
AutoLoadCooldown=5
